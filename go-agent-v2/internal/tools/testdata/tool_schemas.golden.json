[
  {
    "name": "code_run",
    "description": "Execute a code snippet (Go, JavaScript, TypeScript) or a project shell command. Go snippets can be auto-wrapped with main function and imports. Use mode='project_cmd' for shell commands (only high-risk commands require approval).",
    "inputSchema": {
      "properties": {
        "auto_wrap": {
          "description": "Auto-wrap Go code with package main and imports. Default: true for Go",
          "type": "boolean"
        },
        "code": {
          "description": "Code snippet to execute (for run mode)",
          "type": "string"
        },
        "command": {
          "description": "Shell command (for project_cmd mode)",
          "type": "string"
        },
        "language": {
          "description": "Language: go, javascript, typescript. Required for run mode.",
          "type": "string"
        },
        "mode": {
          "description": "Execution mode. Default: run",
          "enum": [
            "run",
            "project_cmd"
          ],
          "type": "string"
        },
        "timeout": {
          "description": "Timeout in seconds. Default: 30",
          "type": "number"
        },
        "work_dir": {
          "description": "Custom working directory (must be within project root)",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    }
  },
  {
    "name": "code_run_test",
    "description": "Run a specific Go test function. Equivalent to: go test -v -run ^TestFunc$ [package]",
    "inputSchema": {
      "properties": {
        "test_func": {
          "description": "Test function name (e.g. TestMyFunction)",
          "type": "string"
        },
        "test_pkg": {
          "description": "Package path (e.g. ./internal/executor/). Default: ./...",
          "type": "string"
        },
        "timeout": {
          "description": "Timeout in seconds. Default: 30",
          "type": "number"
        }
      },
      "required": [
        "test_func"
      ],
      "type": "object"
    }
  },
  {
    "name": "command_get",
    "description": "Get a specific command card by its key, including the command template and argument schema.",
    "inputSchema": {
      "properties": {
        "card_key": {
          "description": "Command card key",
          "type": "string"
        }
      },
      "required": [
        "card_key"
      ],
      "type": "object"
    }
  },
  {
    "name": "command_list",
    "description": "List available command cards. Command cards define reusable operations with templates and argument schemas.",
    "inputSchema": {
      "properties": {
        "keyword": {
          "description": "Search keyword (optional)",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "lsp_call_hierarchy",
    "description": "Get call hierarchy for symbol at file_path:line:column. Direction: incoming|outgoing|both.",
    "inputSchema": {
      "properties": {
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "direction": {
          "description": "Hierarchy direction (default: both)",
          "enum": [
            "incoming",
            "outgoing",
            "both"
          ],
          "type": "string"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "line": {
          "description": "0-indexed line number",
          "type": "number"
        }
      },
      "required": [
        "file_path",
        "line",
        "column"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_code_action",
    "description": "Get code actions/commands at a document range. Supports optional end_line/end_column and action kinds filter.",
    "inputSchema": {
      "properties": {
        "column": {
          "description": "0-indexed start column number",
          "type": "number"
        },
        "end_column": {
          "description": "0-indexed end column number (default: column)",
          "type": "number"
        },
        "end_line": {
          "description": "0-indexed end line number (default: line)",
          "type": "number"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "line": {
          "description": "0-indexed start line number",
          "type": "number"
        },
        "only": {
          "description": "Optional code action kinds filter",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "file_path",
        "line",
        "column"
      ],
      "type": "object"
    }
  },
  {
