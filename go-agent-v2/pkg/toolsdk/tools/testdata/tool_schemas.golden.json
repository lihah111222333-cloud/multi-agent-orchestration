          "type": "string"
        },
        "query": {
          "description": "Search query",
          "type": "string"
        },
        "symbol": {
          "description": "Symbol query for AST search",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  },
