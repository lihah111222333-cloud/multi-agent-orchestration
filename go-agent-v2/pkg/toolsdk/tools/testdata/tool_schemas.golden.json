        },
        "description": {
          "description": "What this DAG does",
          "type": "string"
        },
        "nodes": {
          "items": {
            "properties": {
              "assigned_to": {
                "description": "Agent ID to assign this node to",
                "type": "string"
              },
              "command_ref": {
                "description": "Command card key to use",
                "type": "string"
              },
              "depends_on": {
                "description": "Node keys this depends on",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "node_key": {
                "description": "Unique key within DAG",
                "type": "string"
              },
              "title": {
                "description": "Node title",
                "type": "string"
              }
            },
            "required": [
              "node_key",
              "title"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "title": {
          "description": "DAG title",
          "type": "string"
        }
      },
      "required": [
        "dag_key",
        "title"
      ],
      "type": "object"
    }
  },
