[
  {
    "name": "code_run",
    "description": "Execute a code snippet (Go, JavaScript, TypeScript) or a project shell command. Go snippets can be auto-wrapped with main function and imports. Use mode='project_cmd' for shell commands (only high-risk commands require approval).",
    "inputSchema": {
      "properties": {
        "auto_wrap": {
          "description": "Auto-wrap Go code with package main and imports. Default: true for Go",
          "type": "boolean"
        },
        "code": {
          "description": "Code snippet to execute (for run mode)",
          "type": "string"
        },
        "command": {
          "description": "Shell command (for project_cmd mode)",
          "type": "string"
        },
        "language": {
          "description": "Language: go, javascript, typescript. Required for run mode.",
          "type": "string"
        },
        "mode": {
          "description": "Execution mode. Default: run",
          "enum": [
            "run",
            "project_cmd"
          ],
          "type": "string"
        },
        "timeout": {
          "description": "Timeout in seconds. Default: 30",
          "type": "number"
        },
        "work_dir": {
          "description": "Custom working directory (must be within project root)",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    }
  },
  {
    "name": "code_run_test",
    "description": "Run a specific Go test function. Equivalent to: go test -v -run ^TestFunc$ [package]",
    "inputSchema": {
      "properties": {
        "test_func": {
          "description": "Test function name (e.g. TestMyFunction)",
          "type": "string"
        },
        "test_pkg": {
          "description": "Package path (e.g. ./internal/executor/). Default: ./...",
          "type": "string"
        },
        "timeout": {
          "description": "Timeout in seconds. Default: 30",
          "type": "number"
        }
      },
      "required": [
        "test_func"
      ],
      "type": "object"
    }
  },
  {
    "name": "command_get",
    "description": "Get a specific command card by its key, including the command template and argument schema.",
    "inputSchema": {
      "properties": {
        "card_key": {
          "description": "Command card key",
          "type": "string"
        }
      },
      "required": [
        "card_key"
      ],
      "type": "object"
    }
  },
  {
    "name": "command_list",
    "description": "List available command cards. Command cards define reusable operations with templates and argument schemas.",
    "inputSchema": {
      "properties": {
        "keyword": {
          "description": "Search keyword (optional)",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "lsp_completion",
    "description": "LSP completion suggestions.",
    "inputSchema": {
      "properties": {
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "line": {
          "description": "0-indexed line number",
          "type": "number"
        }
      },
      "required": [
        "file_path",
        "line",
        "column"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_edit",
    "description": "LSP edit operations (rename/code_action/format).",
    "inputSchema": {
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "format"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "code_action"
            }
          },
          "required": [
            "action",
            "file_path",
            "line",
            "column"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "rename"
            }
          },
          "required": [
            "action",
            "file_path",
            "line",
            "column",
            "new_name"
          ]
        }
      ],
      "properties": {
        "action": {
          "description": "Edit action.",
          "enum": [
            "rename",
            "code_action",
            "format"
          ],
          "type": "string"
        },
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "end_column": {
          "description": "Optional end column for code_action.",
          "type": "number"
        },
        "end_line": {
          "description": "Optional end line for code_action.",
          "type": "number"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "insert_spaces": {
          "description": "Use spaces for format.",
          "type": "boolean"
        },
        "line": {
          "description": "0-indexed line number",
          "type": "number"
        },
        "new_name": {
          "description": "New symbol name for rename.",
          "type": "string"
        },
        "only": {
          "description": "Optional code action kinds filter.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tab_size": {
          "description": "Tab size for format.",
          "type": "number"
        }
      },
      "required": [
        "action",
        "file_path"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_file",
    "description": "LSP file operations (open/change).",
    "inputSchema": {
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "open"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "change"
            }
          },
          "required": [
            "action",
            "file_path",
            "new_content"
          ]
        }
      ],
      "properties": {
        "action": {
          "description": "File action.",
          "enum": [
            "open",
            "change"
          ],
          "type": "string"
        },
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "line": {
          "description": "0-indexed line number",
          "type": "number"
        },
        "new_content": {
          "description": "Full new content for action=change.",
          "type": "string"
        },
        "persist_to_disk": {
          "description": "Persist to disk when action=change.",
          "type": "boolean"
        },
        "version": {
          "description": "Optional document version.",
          "type": "number"
        }
      },
      "required": [
        "action",
        "file_path"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_grep",
    "description": "Workspace grep operations (text_search/ast_search).",
    "inputSchema": {
      "properties": {
        "action": {
          "description": "Grep action.",
          "enum": [
            "text_search",
            "ast_search"
          ],
          "type": "string"
        },
        "lang": {
          "description": "Optional language hint for ast_search.",
          "type": "string"
        },
        "limit": {
          "description": "Optional result limit.",
          "type": "number"
        },
        "path": {
          "description": "Optional path constraint.",
          "type": "string"
        },
        "query": {
          "description": "Search query or AST pattern.",
          "type": "string"
        }
      },
      "required": [
        "action",
        "query"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_inspect",
