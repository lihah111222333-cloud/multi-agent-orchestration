        }
      },
      "required": [
        "action",
        "file_path"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_xref",
    "description": "LSP cross-reference operations.",
    "inputSchema": {
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "workspace_symbol"
            }
          },
          "required": [
            "action",
            "query"
          ]
        },
        {
          "properties": {
            "action": {
              "enum": [
                "definition",
                "references",
                "implementation",
                "type_definition"
              ]
            }
          },
          "required": [
            "action",
            "file_path",
            "line",
            "column"
          ]
        }
      ],
      "properties": {
        "action": {
          "description": "XRef action.",
          "enum": [
            "definition",
            "references",
            "implementation",
            "type_definition",
            "workspace_symbol"
          ],
          "type": "string"
        },
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "include_declaration": {
          "description": "Include declaration for references action.",
          "type": "boolean"
        },
        "line": {
          "description": "0-indexed line number",
          "type": "number"
        },
        "query": {
          "description": "Workspace symbol query for action=workspace_symbol.",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  },
  {
    "name": "orchestration_launch_agent",
    "description": "Launch a new agent subprocess. The new agent will also have orchestration tools injected.",
    "inputSchema": {
      "properties": {
        "cwd": {
          "description": "Working directory (optional, defaults to '.')",
          "type": "string"
        },
        "name": {
          "description": "Display name for the new agent",
          "type": "string"
        },
        "prompt": {
          "description": "Initial prompt (optional)",
          "type": "string"
        },
        "workspace_run_key": {
          "description": "Optional workspace run key. If provided, agent cwd is resolved to that run's virtual workspace.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  {
    "name": "orchestration_list_agents",
    "description": "List all running agents with their ID, name, state, port and thread ID.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "orchestration_send_message",
    "description": "Send a message to another running agent by its ID. The message will be submitted as a new turn prompt.",
    "inputSchema": {
      "properties": {
        "agent_id": {
          "description": "Target agent ID",
          "type": "string"
        },
        "message": {
          "description": "Message to send",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "message"
      ],
      "type": "object"
    }
  },
  {
    "name": "orchestration_stop_agent",
    "description": "Stop a running agent by its ID.",
    "inputSchema": {
      "properties": {
        "agent_id": {
          "description": "Agent ID to stop",
          "type": "string"
        }
      },
      "required": [
        "agent_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "prompt_get",
    "description": "Get a specific prompt template by its key, including the prompt text and variables.",
    "inputSchema": {
      "properties": {
        "prompt_key": {
          "description": "Prompt template key",
          "type": "string"
        }
      },
      "required": [
        "prompt_key"
      ],
      "type": "object"
    }
  },
  {
    "name": "prompt_list",
    "description": "List available prompt templates. Templates can be used to generate structured prompts for agents.",
    "inputSchema": {
      "properties": {
        "keyword": {
          "description": "Search keyword (optional)",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "shared_file_read",
    "description": "Read a shared file by path. Shared files are stored in the database and can be accessed by all agents.",
    "inputSchema": {
      "properties": {
        "path": {
          "description": "File path (e.g. 'config/settings.json')",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "shared_file_write",
    "description": "Write content to a shared file. Creates or overwrites the file at the given path.",
    "inputSchema": {
      "properties": {
        "content": {
          "description": "File content to write",
          "type": "string"
        },
        "path": {
          "description": "File path (e.g. 'config/settings.json')",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "type": "object"
    }
  },
  {
    "name": "task_create_dag",
    "description": "Create a task DAG with nodes. Each node can have dependencies, be assigned to an agent, and reference a command card.",
    "inputSchema": {
      "properties": {
        "dag_key": {
          "description": "Unique key for the DAG",
          "type": "string"
        },
        "description": {
          "description": "What this DAG does",
          "type": "string"
        },
        "nodes": {
          "items": {
            "properties": {
              "assigned_to": {
                "description": "Agent ID to assign this node to",
                "type": "string"
              },
              "command_ref": {
                "description": "Command card key to use",
                "type": "string"
              },
              "depends_on": {
                "description": "Node keys this depends on",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "node_key": {
                "description": "Unique key within DAG",
                "type": "string"
              },
              "title": {
                "description": "Node title",
                "type": "string"
              }
            },
            "required": [
              "node_key",
              "title"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "title": {
          "description": "DAG title",
          "type": "string"
        }
      },
      "required": [
        "dag_key",
        "title"
      ],
      "type": "object"
    }
  },
  {
    "name": "task_get_dag",
    "description": "Get a task DAG with all its nodes and their statuses.",
    "inputSchema": {
      "properties": {
        "dag_key": {
          "description": "DAG key to look up",
          "type": "string"
        }
      },
      "required": [
        "dag_key"
      ],
      "type": "object"
    }
  },
  {
    "name": "task_update_node",
    "description": "Update a task DAG node's status (pending/running/done/failed).",
    "inputSchema": {
      "properties": {
        "dag_key": {
          "description": "DAG key",
          "type": "string"
        },
        "node_key": {
          "description": "Node key to update",
          "type": "string"
        },
        "result": {
          "description": "Result summary (optional)",
          "type": "string"
        },
        "status": {
          "description": "New status: pending, running, done, failed",
          "enum": [
            "pending",
            "running",
            "done",
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "dag_key",
        "node_key",
        "status"
      ],
      "type": "object"
    }
  },
  {
    "name": "workspace_abort_run",
    "description": "Abort a workspace run and mark it as aborted in PostgreSQL state.",
    "inputSchema": {
      "properties": {
        "reason": {
          "description": "Abort reason (optional).",
          "type": "string"
        },
        "run_key": {
          "description": "Workspace run key.",
          "type": "string"
        },
        "updated_by": {
          "description": "Operator id (optional).",
          "type": "string"
        }
      },
      "required": [
        "run_key"
      ],
      "type": "object"
    }
  },
  {
    "name": "workspace_create_run",
    "description": "Create a virtual workspace run. Filesystem workspace is used for edits; run status and file states are persisted in PostgreSQL.",
    "inputSchema": {
      "properties": {
        "created_by": {
          "description": "Creator identifier (optional).",
          "type": "string"
        },
        "dag_key": {
          "description": "Related DAG key (optional).",
          "type": "string"
        },
        "files": {
          "description": "Optional bootstrap files to copy from source root to workspace.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "metadata": {
          "description": "Optional metadata for run record.",
          "type": "object"
        },
        "run_key": {
          "description": "Optional run key. Auto-generated if omitted.",
          "type": "string"
        },
        "source_root": {
          "description": "Absolute or relative source project root.",
          "type": "string"
        }
      },
      "required": [
        "source_root"
      ],
      "type": "object"
    }
  },
  {
    "name": "workspace_get_run",
    "description": "Get workspace run detail by run key.",
    "inputSchema": {
      "properties": {
        "run_key": {
          "description": "Workspace run key.",
          "type": "string"
        }
      },
      "required": [
        "run_key"
      ],
      "type": "object"
    }
  },
  {
    "name": "workspace_list_runs",
    "description": "List workspace runs with optional status/dag filters.",
    "inputSchema": {
      "properties": {
        "dag_key": {
          "description": "Optional DAG key filter.",
          "type": "string"
        },
        "limit": {
          "description": "Max number of runs to return.",
          "type": "number"
        },
        "status": {
          "description": "Optional run status filter.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "workspace_merge_run",
    "description": "Merge changed files from virtual workspace back to source root with conflict detection. Also updates PostgreSQL run/file states.",
    "inputSchema": {
      "properties": {
        "delete_removed": {
          "description": "Delete source files removed in workspace when safe.",
          "type": "boolean"
        },
        "dry_run": {
          "description": "Only simulate merge without writing source files.",
          "type": "boolean"
        },
        "run_key": {
          "description": "Workspace run key.",
          "type": "string"
        },
        "updated_by": {
          "description": "Operator id (optional).",
          "type": "string"
        }
      },
      "required": [
        "run_key"
      ],
      "type": "object"
    }
  }
]
