[
  {
    "name": "code_run",
    "description": "Execute a code snippet (Go, JavaScript, TypeScript) or a project shell command. Go snippets can be auto-wrapped with main function and imports. Use mode='project_cmd' for shell commands (only high-risk commands require approval).",
    "inputSchema": {
      "properties": {
        "auto_wrap": {
          "description": "Auto-wrap Go code with package main and imports. Default: true for Go",
          "type": "boolean"
        },
        "code": {
          "description": "Code snippet to execute (for run mode)",
          "type": "string"
        },
        "command": {
          "description": "Shell command (for project_cmd mode)",
          "type": "string"
        },
        "language": {
          "description": "Language: go, javascript, typescript. Required for run mode.",
          "type": "string"
        },
        "mode": {
          "description": "Execution mode. Default: run",
          "enum": [
            "run",
            "project_cmd"
          ],
          "type": "string"
        },
        "timeout": {
          "description": "Timeout in seconds. Default: 30",
          "type": "number"
        },
        "work_dir": {
          "description": "Custom working directory (must be within project root)",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    }
  },
  {
    "name": "code_run_test",
    "description": "Run a specific Go test function. Equivalent to: go test -v -run ^TestFunc$ [package]",
    "inputSchema": {
      "properties": {
        "test_func": {
          "description": "Test function name (e.g. TestMyFunction)",
          "type": "string"
        },
        "test_pkg": {
          "description": "Package path (e.g. ./internal/executor/). Default: ./...",
          "type": "string"
        },
        "timeout": {
          "description": "Timeout in seconds. Default: 30",
          "type": "number"
        }
      },
      "required": [
        "test_func"
      ],
      "type": "object"
    }
  },
  {
    "name": "command_get",
    "description": "Get a specific command card by its key, including the command template and argument schema.",
    "inputSchema": {
      "properties": {
        "card_key": {
          "description": "Command card key",
          "type": "string"
        }
      },
      "required": [
        "card_key"
      ],
      "type": "object"
    }
  },
  {
    "name": "command_list",
    "description": "List available command cards. Command cards define reusable operations with templates and argument schemas.",
    "inputSchema": {
      "properties": {
        "keyword": {
          "description": "Search keyword (optional)",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "lsp_completion",
    "description": "Code completion suggestions at a cursor position.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "line": {
          "description": "0-indexed line number",
          "type": "number"
        }
      },
      "required": [
        "file_path",
        "line",
        "column"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_edit",
    "description": "Editing operations: rename/code_action/format/replace_range.",
    "inputSchema": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "rename"
            }
          },
          "required": [
            "action",
            "file_path",
            "line",
            "column",
            "new_name"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "code_action"
            }
          },
          "required": [
            "action",
            "file_path",
            "line",
            "column"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "format"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "replace_range"
            }
          },
          "required": [
            "action",
            "file_path",
            "line",
            "column",
            "end_line",
            "end_column",
            "new_text"
          ]
        }
      ],
      "properties": {
        "action": {
          "description": "Edit operation",
          "enum": [
            "rename",
            "code_action",
            "format",
            "replace_range"
          ],
          "type": "string"
        },
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "end_column": {
          "description": "0-indexed end column",
          "type": "number"
        },
        "end_line": {
          "description": "0-indexed end line",
          "type": "number"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "insert_spaces": {
          "description": "Use spaces for formatting",
          "type": "boolean"
        },
        "line": {
          "description": "0-indexed line number",
          "type": "number"
        },
        "new_name": {
          "description": "New symbol name for rename",
          "type": "string"
        },
        "new_text": {
          "description": "Replacement text for replace_range",
          "type": "string"
        },
        "only": {
          "description": "Code action kinds filter",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "persist_to_disk": {
          "description": "Persist replace_range result to disk",
          "type": "boolean"
        },
        "tab_size": {
          "description": "Tab size for formatting",
          "type": "number"
        },
        "version": {
          "description": "Document version",
          "type": "number"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_file",
    "description": "File-level LSP operations: open/read/sync document state and query diagnostics.",
    "inputSchema": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "open_file"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "read_file"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "did_change"
            }
          },
          "required": [
            "action",
            "file_path",
            "new_content"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "diagnostics"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        }
      ],
      "properties": {
        "action": {
          "description": "File operation to execute",
          "enum": [
            "open_file",
            "read_file",
            "did_change",
            "diagnostics"
          ],
          "type": "string"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "new_content": {
          "description": "Full new document content for did_change",
          "type": "string"
        },
        "persist_to_disk": {
          "description": "Persist did_change content to disk",
          "type": "boolean"
        },
        "version": {
          "description": "Document version",
          "type": "number"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  },
  {
    "name": "lsp_grep",
    "description": "Search source text and symbols (text search / AST search).",
    "inputSchema": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "text_search"
            }
          },
          "required": [
            "action",
            "query"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "ast_search"
            }
          },
          "required": [
            "action",
            "language",
            "symbol"
          ]
        }
      ],
      "properties": {
        "action": {
          "description": "Search operation",
          "enum": [
            "text_search",
            "ast_search"
          ],
          "type": "string"
        },
        "case_sensitive": {
          "description": "Case sensitive match",
          "type": "boolean"
        },
        "glob": {
          "description": "Glob filter for file paths",
          "type": "string"
