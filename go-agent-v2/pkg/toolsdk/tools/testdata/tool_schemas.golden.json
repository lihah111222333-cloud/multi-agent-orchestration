              ]
            }
          },
          "required": [
            "action",
            "file_path",
            "line",
            "column"
          ]
        }
      ],
      "properties": {
        "action": {
          "description": "Inspect action.",
          "enum": [
            "hover",
            "diagnostics",
            "signature_help"
          ],
          "type": "string"
        },
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "line": {
          "description": "0-indexed line number",
          "type": "number"
        }
      },
      "required": [
