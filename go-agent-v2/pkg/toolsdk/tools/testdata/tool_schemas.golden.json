  {
    "name": "lsp_structure",
    "description": "Structural LSP views: document/workspace symbols, folding and semantic tokens.",
    "inputSchema": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "document_symbol"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "folding_range"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "semantic_tokens"
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "oneOf": [
            {
              "not": {
                "required": [
