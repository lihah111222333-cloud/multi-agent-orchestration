      "oneOf": [
        {
          "properties": {
            "action": {
              "enum": [
                "document_symbol",
                "semantic_tokens",
                "folding_range"
              ]
            }
          },
          "required": [
            "action",
            "file_path"
          ]
        },
        {
          "properties": {
            "action": {
              "enum": [
                "call_hierarchy",
                "type_hierarchy"
              ]
            }
          },
          "required": [
            "action",
            "file_path",
            "line",
            "column"
          ]
        }
      ],
      "properties": {
        "action": {
          "description": "Structure action.",
          "enum": [
            "document_symbol",
            "call_hierarchy",
            "type_hierarchy",
            "semantic_tokens",
            "folding_range"
          ],
          "type": "string"
        },
        "column": {
          "description": "0-indexed column number",
          "type": "number"
        },
        "direction": {
          "description": "Hierarchy direction.",
          "enum": [
            "incoming",
            "outgoing",
            "both",
            "supertypes",
            "subtypes"
          ],
          "type": "string"
        },
        "file_path": {
          "description": "Absolute or relative path to the file",
          "type": "string"
        },
        "line": {
          "description": "0-indexed line number",
